MODELROUTE_APP_NAME=ModelRoute
MODELROUTE_APP_ENV=development
MODELROUTE_MOCK_MODEL=mock-model

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

DEFAULT_PROVIDER=openai
PROVIDER_TIMEOUT_SECONDS=20
PROVIDER_MAX_RETRIES=1
PROVIDER_RETRY_DELAY_SECONDS=0.25

REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql+asyncpg://modelroute:modelroute@localhost:5432/modelroute
CACHE_TTL_SECONDS=300
RATE_LIMIT_CAPACITY=20
RATE_LIMIT_REFILL_RATE=1.0

OPENAI_INPUT_COST_PER_MILLION=0.20
OPENAI_OUTPUT_COST_PER_MILLION=1.20
GEMINI_INPUT_COST_PER_MILLION=0.75
GEMINI_OUTPUT_COST_PER_MILLION=3.75

INITIAL_PROVIDER_LATENCY_MS=1000
LATENCY_EWMA_ALPHA=0.3
